# Supabase Auth. These two are PUBLIC by design and are bundled into the browser
# (hence VITE_). The server also reads them to verify the user's session on
# /api/generate. Use the publishable key, never the service_role/secret key.
# Find both in Supabase: Project Settings > API Keys.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Stripe Payment Link for the $9.99 one-time purchase. PUBLIC by design (bundled
# into the browser). The app appends client_reference_id/prefilled_email to it.
# Without it, signed-in users see "Payments are not configured yet".
VITE_STRIPE_PAYMENT_LINK_URL=https://buy.stripe.com/...

# Everything below is server-side only. These are read by server/proxy.js (dev server and `npm start`)
# and are NEVER bundled into the browser code. Do not prefix them with VITE_.

# n8n production webhook URL (required, must be https).
WEBHOOK_URL=https://YOUR-INSTANCE.app.n8n.cloud/webhook/YOUR-WEBHOOK-ID

# Shared secret sent to n8n on every request. In the Webhook node set
# Authentication = Header Auth with the same header name and value.
# Generate a value with: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
WEBHOOK_AUTH_HEADER=X-Webhook-Secret
WEBHOOK_AUTH_VALUE=

# Optional: extra origins allowed to call /api/generate (comma-separated).
# Same-origin requests are always allowed.
ALLOWED_ORIGINS=

# Optional: set to true only when running behind a reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=false

# Optional limits (defaults shown).
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MS=600000
MAX_CONCURRENT=4
UPSTREAM_TIMEOUT_MS=60000

# Production server bind address (`npm start`).
HOST=127.0.0.1
PORT=3000
